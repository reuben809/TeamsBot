# =============================================================================
# Atlassian Teams Bot — Environment Configuration
# Copy this file to .env and fill in the values before starting the service.
# =============================================================================

# ---------------------------------------------------------------------------
# Microsoft Bot Framework
# Register your bot at https://dev.botframework.com/ (or Azure Bot Service)
# Leave blank for local testing with the Bot Framework Emulator
# ---------------------------------------------------------------------------
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Credential Encryption
# Generate a random 32-character string: openssl rand -hex 16
# KEEP THIS SECRET — changing it invalidates all existing user sessions
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=change-me-use-openssl-rand-hex-16

# ---------------------------------------------------------------------------
# AI Backend
#
# Option A — GitHub Models (FREE, requires GitHub account):
#   AI_ENDPOINT=https://models.inference.ai.azure.com
#   AI_API_KEY=<your GitHub personal access token>
#   AI_MODEL=gpt-4o-mini
#
# Option B — Azure OpenAI:
#   AI_ENDPOINT=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   AI_API_KEY=<Azure OpenAI key>
#   AI_MODEL=gpt-4o-mini
#
# Option C — Azure AI Foundry (serverless):
#   AI_ENDPOINT=https://<endpoint>.services.ai.azure.com/models
#   AI_API_KEY=<Azure AI Foundry key>
#   AI_MODEL=gpt-4o-mini
# ---------------------------------------------------------------------------
AI_ENDPOINT=https://models.inference.ai.azure.com
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# MCP Server (mcp-atlassian running in HTTP mode)
# When using docker-compose this is automatically set to the container name.
# For local development, start mcp-atlassian first:
#   uv run mcp-atlassian --transport streamable-http --port 3000
# ---------------------------------------------------------------------------
MCP_SERVER_URL=http://localhost:3000/mcp

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3978
LOG_LEVEL=info
NODE_ENV=production
