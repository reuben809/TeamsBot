{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "packageName": "com.yourcompany.atlassian-teams-bot",
  "developer": {
    "name": "Your Company",
    "websiteUrl": "https://yourcompany.com",
    "privacyUrl": "https://yourcompany.com/privacy",
    "termsOfUseUrl": "https://yourcompany.com/terms"
  },
  "name": {
    "short": "Atlassian Bot",
    "full": "Atlassian Jira & Confluence Assistant"
  },
  "description": {
    "short": "AI-powered Jira and Confluence assistant",
    "full": "Interact with your Atlassian Jira and Confluence accounts directly inside Microsoft Teams using natural language. Search issues, create tickets, query sprints, and explore Confluence pages — all without leaving Teams."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0052CC",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupchat"],
          "commands": [
            {
              "title": "help",
              "description": "Show available commands"
            },
            {
              "title": "reconnect",
              "description": "Re-enter your Atlassian credentials"
            },
            {
              "title": "disconnect",
              "description": "Clear saved credentials and disconnect"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": []
}
